# Copy to .env.local (or set in your host's dashboard) and fill in.

# Public URL of the site, no trailing slash. Used for share links, X callback and metadata.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Sign in with X (developer.x.com: create an app with OAuth 2.0, type "Web App")
# Leave these empty to use the temporary mode where recruits type their X handle.
# Filling them in switches the site to Sign in with X automatically.
# Callback URL to register in the X app: https://yourdomain.com/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# REQUIRED in production (both sign in modes). Long random string that signs session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Cloudflare Turnstile bot check (optional but recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Database: Google Sheets via Apps Script (setup: scripts/apps-script/README.md).
# Leave empty to keep progress in each visitor's browser only.
GOOGLE_SHEETS_WEBAPP_URL=
# Optional but recommended: must match SHARED_SECRET in Code.gs
SHEETS_WEBHOOK_SECRET=

# Alternative database for heavy traffic (upstash.com, Redis, REST API credentials).
# Takes priority over the sheet when set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for the CSV export at /api/admin/export?key=...
ADMIN_KEY=

# X post people are asked to repost
NEXT_PUBLIC_PINNED_POST=https://x.com/militiaRH/status/...

# Invite quality rules: an invite only counts if the new account is at least this old and has this many followers
REF_MIN_ACCOUNT_DAYS=30
REF_MIN_FOLLOWERS=10

# Allowlist snapshot date for the countdown (ISO, UTC). Leave empty to hide the countdown.
NEXT_PUBLIC_SNAPSHOT_AT=
